# env / secrets
.env
*.env
!*.env.example

# локальний зсув портів — не комітиться: CI очікує стандартні порти
docker-compose.override.yml

# слід виконання задач агентами (Tasks / Plans / Research / Critic / Tests /
# Review / Devops) — локальний робочий журнал мейнтейнера, не частина курсу
.agent/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# .net
bin/
obj/

# node / angular
node_modules/
dist/
.angular/

# os / editor
.DS_Store
Thumbs.db
.idea/
# .vscode/* , а не .vscode/ — git не заходить усередину ігнорованої теки,
# і виняток нижче просто не розглядався б
.vscode/*
# спільні налаштування проєкту лишаємо: вони стосуються всіх, хто відкриє
# стартер, а не чиїхось особистих звичок
!.vscode/settings.json
